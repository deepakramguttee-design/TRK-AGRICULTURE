    "whatsapp": "WhatsApp",
    "address": "Address",
    "note": "For orders, the easiest way is through our online catalogue. For bulk orders (hotels, restaurants, resellers), contact us directly via WhatsApp or email.",
    "viewCatalog": "View catalogue"
