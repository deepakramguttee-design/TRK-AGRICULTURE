  "process": {
    "title": "Our Process",
    "subtitle": "From substrate to your garden — how our seedlings come to life",
    "plateauTitle": "Tray-cell cultivation",
    "plateauDesc": "All our seedlings are grown in cell trays in a controlled environment. Each cell holds a single seed, carefully nurtured until it reaches the ideal stage for transplanting into your garden.",
    "standard128": "128-cell tray",
    "standard128Desc": "Standard format for herbs, salads, brèdes and vegetables",
    "cucu98": "98-cell tray",
    "cucu98Desc": "Larger cells for cucurbits: melons, watermelons, cucumbers",
    "stepsTitle": "The 6 production stages",
    "steps": {
      "substrat": {
        "title": "Substrate preparation",
        "desc": "We select and blend peat, perlite and organic compost tailored to each plant family. The substrate ensures ideal drainage and water retention."
      },
      "semis": {
        "title": "Seeding",
        "desc": "One seed is placed per cell at the optimal depth for each species. Every seed is selected for its high germination rate."
      },
      "germination": {
        "title": "Germination",
        "desc": "Under controlled conditions (temperature, humidity), seeds sprout in 3 to 14 days depending on the variety and season."
      },
      "croissance": {
        "title": "Nursery growth",
        "desc": "Seedlings grow under shelter with regular watering and pest monitoring. This is the longest stage of the production cycle."
      },
      "durcissement": {
        "title": "Hardening off",
        "desc": "Before sale, plants are progressively exposed to outdoor conditions — sunlight, wind, temperature changes — to strengthen their resilience."
      },
      "vente": {
        "title": "Ready to sell",
        "desc": "The plant is vigorous, well-rooted in its cell, and ready to be transplanted into your garden bed, pot or raised planter."
      }
    },
    "durationsTitle": "Production timelines by category",
    "durationsNote": "Approximate timelines in Mauritius. The hot season (Nov – Apr) speeds up growth; the cool season (May – Oct) slows it slightly.",
    "durationCols": {
      "category": "Category",
      "germination": "Germination",
      "nursery": "Nursery",
      "total": "Total",
      "examples": "Example varieties"
    },
    "durations": {
      "epices": {
